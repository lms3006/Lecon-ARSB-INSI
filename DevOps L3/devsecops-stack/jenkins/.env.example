# ============================================================
#  JENKINS - VARIABLES D'ENVIRONNEMENT
#  Copiez ce fichier en .env et renseignez vos valeurs
#  IMPORTANT: Ne commitez JAMAIS ce fichier en Git !
#  Ajoutez .env dans votre .gitignore
# ============================================================

# --- Credentials Jenkins ---
JENKINS_ADMIN_PASSWORD=Admin@Jenkins#2024!
JENKINS_DEV_PASSWORD=Dev@Jenkins#2024!

# --- SonarQube Token ---
# Générez ce token depuis : http://localhost:9000 > My Account > Security
SONARQUBE_TOKEN=CHANGEME_SONAR_TOKEN

# --- HashiCorp Vault AppRole ---
# Généré lors de l'initialisation de Vault (voir vault/scripts/init-vault.sh)
VAULT_ROLE_ID=CHANGEME_VAULT_ROLE_ID
VAULT_SECRET_ID=CHANGEME_VAULT_SECRET_ID

# --- Git Credentials ---
GIT_USERNAME=your-git-username
GIT_PASSWORD=your-git-token

# --- Shared Pipeline Library (optionnel) ---
SHARED_LIBRARY_REPO=https://github.com/your-org/jenkins-shared-library.git

# --- Email SMTP (optionnel) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
