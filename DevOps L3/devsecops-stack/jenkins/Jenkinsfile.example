// ============================================================
//  JENKINS PIPELINE DEVSECOPS - EXEMPLE COMPLET
//  
//  Ce Jenkinsfile illustre l'intégration complète:
//    - Secrets récupérés depuis HashiCorp Vault
//    - Analyse de code avec SonarQube
//    - Scan de vulnérabilités avec Trivy
//    - Build et déploiement
//
//  UTILISATION:
//    1. Créez un nouveau Pipeline dans Jenkins
//    2. Sélectionnez "Pipeline script from SCM"
//    3. Pointez vers votre dépôt contenant ce Jenkinsfile
// ============================================================

pipeline {
    agent any

    // ── Variables d'environnement ──────────────────────────
    environment {
        APP_NAME        = "mon-application"
        DOCKER_REGISTRY = "registry.example.com"
        SONAR_PROJECT   = "mon-application"
    }

    // ── Options globales ───────────────────────────────────
    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        ansiColor('xterm')
    }

    // ── Paramètres ─────────────────────────────────────────
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Environnement de déploiement'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Ignorer les tests (non recommandé)'
        )
        booleanParam(
            name: 'SKIP_SONAR',
            defaultValue: false,
            description: 'Ignorer l\'analyse SonarQube'
        )
    }

    stages {

        // ══════════════════════════════════════════════════
        //  STAGE 1: RÉCUPÉRATION DES SECRETS DEPUIS VAULT
        // ══════════════════════════════════════════════════
        stage('🔐 Récupération des Secrets (Vault)') {
            steps {
                script {
                    // Récupération via le plugin HashiCorp Vault
                    withVault(
                        configuration: [
                            vaultUrl: 'http://vault:8200',
                            vaultCredential: 'vault-role-id',
                            engineVersion: 2
                        ],
                        vaultSecrets: [
                            [
                                path: 'secret/jenkins/sonarqube',
                                secretValues: [
                                    [envVar: 'SONAR_TOKEN',  vaultKey: 'token'],
                                    [envVar: 'SONAR_URL',    vaultKey: 'url']
                                ]
                            ],
                            [
                                path: 'secret/jenkins/git',
                                secretValues: [
                                    [envVar: 'GIT_USER',  vaultKey: 'username'],
                                    [envVar: 'GIT_TOKEN', vaultKey: 'token']
                                ]
                            ],
                            [
                                path: 'infra/docker/registry',
                                secretValues: [
                                    [envVar: 'REGISTRY_USER', vaultKey: 'username'],
                                    [envVar: 'REGISTRY_PASS', vaultKey: 'password'],
                                    [envVar: 'REGISTRY_URL',  vaultKey: 'url']
                                ]
                            ]
                        ]
                    ) {
                        echo "✅ Secrets récupérés depuis Vault"
                        // Les variables sont disponibles dans ce bloc
                        sh 'echo "SonarQube URL: $SONAR_URL"'
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 2: CHECKOUT DU CODE SOURCE
        // ══════════════════════════════════════════════════
        stage('📦 Checkout') {
            steps {
                checkout scm
                sh '''
                    echo "Branch: ${GIT_BRANCH}"
                    echo "Commit: ${GIT_COMMIT}"
                    git log --oneline -5
                '''
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 3: BUILD
        // ══════════════════════════════════════════════════
        stage('🔨 Build') {
            steps {
                script {
                    // Exemple Maven (adaptez selon votre stack)
                    sh '''
                        mvn clean package \
                            -DskipTests=${SKIP_TESTS} \
                            -Dmaven.test.failure.ignore=false
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', allowEmptyArchive: true
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 4: TESTS UNITAIRES
        // ══════════════════════════════════════════════════
        stage('🧪 Tests Unitaires') {
            when {
                expression { !params.SKIP_TESTS }
            }
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
                    jacoco(
                        execPattern: '**/target/jacoco.exec',
                        classPattern:  '**/target/classes',
                        sourcePattern: '**/src/main/java'
                    )
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 5: ANALYSE SONARQUBE
        // ══════════════════════════════════════════════════
        stage('🔍 Analyse SonarQube') {
            when {
                expression { !params.SKIP_SONAR }
            }
            steps {
                withVault(
                    configuration: [
                        vaultUrl: 'http://vault:8200',
                        vaultCredential: 'vault-role-id',
                        engineVersion: 2
                    ],
                    vaultSecrets: [[
                        path: 'secret/jenkins/sonarqube',
                        secretValues: [
                            [envVar: 'SONAR_TOKEN', vaultKey: 'token']
                        ]
                    ]]
                ) {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=${SONAR_PROJECT} \
                                -Dsonar.projectName="${APP_NAME}" \
                                -Dsonar.projectVersion=${BUILD_NUMBER} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                                -Dsonar.java.coveragePlugin=jacoco
                        """
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 6: QUALITY GATE SONARQUBE
        // ══════════════════════════════════════════════════
        stage('✅ Quality Gate') {
            when {
                expression { !params.SKIP_SONAR }
            }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 7: SCAN DE VULNÉRABILITÉS (OWASP + TRIVY)
        // ══════════════════════════════════════════════════
        stage('🛡️ Scan de Sécurité') {
            parallel {

                stage('OWASP Dependency Check') {
                    steps {
                        dependencyCheck(
                            additionalArguments: """
                                --scan target/
                                --format HTML
                                --format JSON
                                --out dependency-check-report
                                --suppression suppression.xml
                            """,
                            odcInstallation: 'OWASP-DC'
                        )
                    }
                    post {
                        always {
                            dependencyCheckPublisher(
                                pattern: 'dependency-check-report/dependency-check-report.xml'
                            )
                        }
                    }
                }

                stage('Trivy - Scan Image Docker') {
                    steps {
                        sh """
                            trivy image \
                                --format table \
                                --exit-code 0 \
                                --severity HIGH,CRITICAL \
                                --no-progress \
                                ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER} \
                                | tee trivy-report.txt
                        """
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'trivy-report.txt', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 8: BUILD IMAGE DOCKER
        // ══════════════════════════════════════════════════
        stage('🐳 Build Docker') {
            steps {
                script {
                    def image = docker.build("${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}")
                    env.DOCKER_IMAGE = "${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 9: PUSH REGISTRY
        // ══════════════════════════════════════════════════
        stage('📤 Push Registry') {
            steps {
                withVault(
                    configuration: [
                        vaultUrl: 'http://vault:8200',
                        vaultCredential: 'vault-role-id',
                        engineVersion: 2
                    ],
                    vaultSecrets: [[
                        path: 'infra/docker/registry',
                        secretValues: [
                            [envVar: 'REGISTRY_USER', vaultKey: 'username'],
                            [envVar: 'REGISTRY_PASS', vaultKey: 'password']
                        ]
                    ]]
                ) {
                    sh """
                        echo \$REGISTRY_PASS | docker login ${DOCKER_REGISTRY} \
                            -u \$REGISTRY_USER \
                            --password-stdin
                        docker push ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER}
                        docker tag ${DOCKER_REGISTRY}/${APP_NAME}:${BUILD_NUMBER} \
                                   ${DOCKER_REGISTRY}/${APP_NAME}:latest
                        docker push ${DOCKER_REGISTRY}/${APP_NAME}:latest
                    """
                }
            }
        }

        // ══════════════════════════════════════════════════
        //  STAGE 10: DÉPLOIEMENT
        // ══════════════════════════════════════════════════
        stage('🚀 Déploiement') {
            steps {
                script {
                    def env_name = params.ENVIRONMENT
                    echo "Déploiement sur: ${env_name}"

                    // Exemple: déploiement via kubectl ou docker compose
                    // sh "kubectl set image deployment/${APP_NAME} ${APP_NAME}=${DOCKER_IMAGE} -n ${env_name}"
                }
            }
        }
    }

    // ── Post-build ─────────────────────────────────────────
    post {
        always {
            // Nettoyage du workspace
            cleanWs()
            // Déconnexion Docker
            sh 'docker logout ${DOCKER_REGISTRY} || true'
        }
        success {
            echo "✅ Pipeline réussi ! Build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Pipeline échoué ! Consultez les logs."
            // emailext(
            //     to: 'team@example.com',
            //     subject: "ÉCHEC: ${APP_NAME} - Build #${BUILD_NUMBER}",
            //     body: "Le pipeline a échoué. URL: ${BUILD_URL}"
            // )
        }
        unstable {
            echo "⚠️ Pipeline instable (tests échoués ou Quality Gate)"
        }
    }
}
